// Zemlo — schema canónico da base de dados.
//
// Este é o schema de PRODUÇÃO (PostgreSQL). A variante SQLite usada em desenvolvimento
// e em testes locais é GERADA a partir deste ficheiro por
// `apps/api/scripts/sync-sqlite-schema.mjs` e nunca deve ser editada à mão.
//
// Duas decisões estruturais que explicam a forma deste schema:
//
// 1. NÃO existem `enum` do Prisma/PostgreSQL. Todos os conjuntos fechados de valores
//    (categorias de despesa, tipos de manutenção, ...) são `String` validada pelo
//    registo de domínio em `@zemlo/shared/registry`. Isto mantém o schema portável
//    entre PostgreSQL e SQLite e permite acrescentar uma categoria nova sem migração
//    de tipo — requisito direto do princípio "crescer sem crescer em complexidade" (§62).
//
// 2. As datas civis (data de uma despesa, validade de um documento, data de inspeção)
//    são `DateTime @db.Date`, não instantes. Uma despesa "de ontem" não tem hora nem
//    fuso horário; guardá-la como instante produziria deslocamentos de um dia em
//    relatórios e alertas. Instantes (auditoria, criação) usam `DateTime` completo.

generator client {
  provider = "prisma-client-js"
  // Saída PRÓPRIA e explícita. Antes desta alteração os dois clientes (PostgreSQL e
  // SQLite) escreviam ambos em `node_modules/.prisma/client`: o último a ser gerado
  // ganhava, e como `db:generate` corria o SQLite por último, o cliente SQLite
  // substituía silenciosamente o de PostgreSQL. A aplicação arrancava, respondia 200 e
  // escrevia num ficheiro local com `DATABASE_URL` a apontar para PostgreSQL.
  //
  // Com saídas distintas o cliente carregado é sempre inequívoco, e `core/db.ts`
  // escolhe-o a partir de `DATABASE_PROVIDER`.
  output = "./generated/postgres"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ========================================================================== */
/* Conta e autenticação (§29, §30)                                            */
/* ========================================================================== */

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  /// Hash bcrypt. Uma password em texto nunca é armazenada (§30).
  passwordHash String?
  name         String?
  locale       String    @default("pt-PT")
  timeZone     String    @default("Europe/Lisbon")
  distanceUnit String    @default("km")
  volumeUnit   String    @default("l")
  currency     String    @default("EUR")

  emailVerified   Boolean   @default(false)
  emailVerifiedAt DateTime?
  /// Provedor de identidade federada: `google`, `apple` ou `null` para email/password.
  authProvider    String?
  authProviderId  String?
  avatarUrl       String?

  /// TOTP (2FA). O segredo é guardado cifrado em repouso (§30).
  twoFactorEnabled Boolean   @default(false)
  twoFactorSecret String?
  twoFactorConfirmedAt DateTime?
  /// Códigos de recuperação: apenas o hash é guardado.
  recoveryCodeHashes Json?

  acceptedTermsAt DateTime?
  termsVersion    String?

  lastLoginAt     DateTime?
  failedLoginCount Int      @default(0)
  lockedUntil     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  /// Eliminação de conta (§30): apagamos de facto; este campo fica para pedidos assíncronos.
  deletedAt DateTime?

  preferences      UserPreference?
  notificationPreferences NotificationPreference[]
  vehicles         Vehicle[]
  sessions         Session[]
  oneTimeTokens    OneTimeToken[]
  expenses         Expense[]
  fuelSessions     FuelSession[]
  chargingSessions ChargingSession[]
  maintenance      MaintenanceRecord[]
  insurancePolicies InsurancePolicy[]
  inspections      InspectionRecord[]
  taxes            TaxRecord[]
  documents        Document[]
  reminders        Reminder[]
  events           VehicleEvent[]
  notifications    Notification[]
  suggestionStates SuggestionState[]
  integrations     Integration[]
  households       HouseholdMember[]
  organizationMembers OrganizationMember[]
  auditLogs        AuditLog[]
  importBookEntries ImportBookEntry[]
  columnMaps        ColumnMap[]

  @@index([authProvider, authProviderId])
}

model UserPreference {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  reminderLeadDays        Int     @default(30)
  reminderLeadKm          Int     @default(1000)
  suggestionsEnabled      Boolean @default(true)
  securityNudgeSnoozeDays Int     @default(90)
  /// Categorias que o utilizador realmente usa, para priorizar a interface (§45).
  frequentExpenseCategories Json?
  /// Campos que o utilizador nunca preenche; deixam de dominar o formulário (§45).
  hiddenFields              Json?
  theme                     String  @default("auto")
  /// Rotina de resumo periódico (`off`, `daily`, `weekly`).
  digestFrequency           String  @default("weekly")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationPreference {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic   String
  channel String
  frequency String @default("immediate")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, topic, channel])
  @@index([userId])
}

/// Sessões de longa duração. O Zemlo é mobile-first: a app tem de continuar
/// autenticada depois de semanas sem abrir, e o utilizador tem de poder revogar
/// um dispositivo perdido (§30).
model Session {
  id String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Hash do refresh token. O valor em claro só existe no cliente.
  refreshTokenHash String @unique
  userAgent         String?
  ipAddress         String?
  deviceLabel       String?
  expiresAt         DateTime
  revokedAt         DateTime?
  lastUsedAt        DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId, expiresAt])
}

/// Token de uso único para verificação de email ou reposição de password.
model OneTimeToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, purpose])
}

/// Registo de ações sensíveis (§30): alterações de password, 2FA, exportações,
/// eliminação de conta, criação de integrações.
model AuditLog {
  id     String @id @default(cuid())
  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  action     String
  entityType String?
  entityId   String?
  /// Metadados não sensíveis: IP, user agent, valores antes/depois redigidos.
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([action, createdAt])
}

/* ========================================================================== */
/* Veículos (§9, §10, §11)                                                    */
/* ========================================================================== */

model Vehicle {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Preparação para famílias e frotas (§32): um veículo pode pertencer a um agregado.
  householdId String?
  household   Household? @relation(fields: [householdId], references: [id], onDelete: SetNull)

  /// Forma canónica normalizada (maiúsculas, sem separadores).
  plate      String
  /// Forma legível com hífenes, para não recalcular no cliente.
  plateDisplay String
  vin        String?
  make       String?
  model      String?
  version    String?
  year       Int?
  vehicleType String  @default("car")
  fuelType    String  @default("gasoline")
  color       String?
  nickname    String?

  // Informação avançada, toda opcional (§10). Nenhum destes campos é obrigatório.
  engineCode          String?
  powerCv             Int?
  engineDisplacementCc Int?
  transmission        String?
  drivetrain          String?
  batteryCapacityKwh  Float?
  usableBatteryKwh    Float?
  rangeKm             Int?
  tankCapacityL       Float?
  tyreSize            String?
  wheelSize           String?
  weightKg            Int?
  co2GKm              Int?

  // Aquisição e propriedade. Alimentam o TCO quando o utilizador quiser (§23).
  purchaseDate       DateTime? @db.Date
  purchasePriceCents Int?
  purchaseOdometerKm Int?
  registrationDate   DateTime? @db.Date
  firstRegistrationDate DateTime? @db.Date

  /// Quilometragem atual conhecida. É um valor derivado, mantido para leitura rápida
  /// no dashboard (§8) sem agregar todo o histórico a cada pedido.
  odometerKm        Int?
  odometerSource     Json?
  odometerUpdatedAt  DateTime?

  notes    String?
  archived Boolean @default(false)
  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  odometerReadings  OdometerReading[]
  expenses          Expense[]
  fuelSessions      FuelSession[]
  chargingSessions  ChargingSession[]
  maintenance       MaintenanceRecord[]
  insurancePolicies InsurancePolicy[]
  inspections       InspectionRecord[]
  taxes             TaxRecord[]
  documents         Document[]
  reminders         Reminder[]
  events            VehicleEvent[]
  integrations      Integration[]

  @@unique([userId, plate])
  @@index([userId, archived])
}

/// Histórico de leituras de odómetro. Existe separado do valor atual do veículo
/// porque a evolução da quilometragem é a base do custo/km, das estatísticas (§23)
/// e da deteção de conflitos entre fontes (§51).
model OdometerReading {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  odometerKm Int
  recordedAt DateTime @db.Date
  source     Json?
  notes      String?
  /// Origem do registo: `manual`, `fuel`, `charging`, `maintenance`, `integration`.
  origin     String  @default("manual")
  /// Registos criados automaticamente a partir de outro documento não devem ser
  /// editáveis isoladamente; apontam para a sua origem.
  originRecordId String?
  /// Marca de correção: quando o utilizador confirmou um recuo de quilometragem (§11).
  isCorrection Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([vehicleId, recordedAt])
  @@index([vehicleId, odometerKm])
}

/* ========================================================================== */
/* Despesas (§12)                                                             */
/* ========================================================================== */

model Expense {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Cêntimos inteiros. Nunca vírgula flutuante (§ money.ts).
  amountCents Int
  vatCents    Int?
  category    String
  date        DateTime @db.Date
  vendor      String?
  odometerKm  Int?
  description String?
  paymentMethod String?
  paid        Boolean @default(true)
  /// Liga a despesa ao registo que a originou (abastecimento, manutenção, ...),
  /// para que o custo não seja contado duas vezes nas estatísticas.
  linkedRecordType String?
  linkedRecordId   String?
  notes       String?
  source      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, date])
  @@index([userId, date])
  @@index([vehicleId, category])
}

/* ========================================================================== */
/* Abastecimentos (§13)                                                       */
/* ========================================================================== */

model FuelSession {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  date               DateTime @db.Date
  litres             Float
  amountCents        Int
  pricePerLitreCents Int?
  odometerKm         Int?
  /// Só um depósito atestado permite calcular o consumo exato por diferença.
  fullTank           Boolean  @default(true)
  station            String?
  fuelType           String?
  latitude           Float?
  longitude          Float?
  paymentMethod      String?
  notes              String?
  source             Json?
  /// Despesa criada automaticamente para este abastecimento, quando o utilizador
  /// quer ver o custo no resumo financeiro (§12).
  expenseId          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, date])
  @@index([vehicleId, odometerKm])
}

/* ========================================================================== */
/* Carregamentos (§14)                                                        */
/* ========================================================================== */

model ChargingSession {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  date           DateTime @db.Date
  energyKwh      Float
  amountCents    Int
  pricePerKwhCents Int?
  odometerKm     Int?
  location       String?
  charger        String?
  durationMinutes Int?
  startSocPercent Float?
  endSocPercent   Float?
  powerKw         Float?
  provider        String?
  tariff          String?
  isPublic        Boolean?
  isHome          Boolean?
  notes           String?
  source          Json?
  expenseId       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, date])
  @@index([vehicleId, odometerKm])
}

/* ========================================================================== */
/* Manutenção (§15)                                                           */
/* ========================================================================== */

model MaintenanceRecord {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime @db.Date
  type        String
  odometerKm  Int?
  amountCents Int?
  partsCents  Int?
  labourCents Int?
  workshop    String?
  description String?
  warrantyMonths Int?
  notes       String?
  nextDueDate DateTime? @db.Date
  nextDueOdometerKm Int?
  source      Json?
  expenseId   String?
  /// Lembrete gerado a partir desta intervenção (§16).
  reminderId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, date])
  @@index([vehicleId, type])
}

/* ========================================================================== */
/* Seguro (§18)                                                               */
/* ========================================================================== */

model InsurancePolicy {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  insurer      String
  policyNumber String?
  startDate    DateTime @db.Date
  endDate      DateTime @db.Date
  premiumCents Int?
  coverage     String?
  deductibleCents Int?
  contactPhone String?
  documentId   String?
  notes        String?
  source       Json?
  /// Lembrete de renovação criado automaticamente a partir da data de fim.
  reminderId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, endDate])
}

/* ========================================================================== */
/* Inspeção (§19)                                                             */
/* ========================================================================== */

model InspectionRecord {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  date        DateTime @db.Date
  result      String   @default("passed")
  odometerKm  Int?
  amountCents Int?
  nextDueDate DateTime? @db.Date
  station     String?
  defects     String?
  documentId  String?
  notes       String?
  source      Json?
  reminderId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, date])
  @@index([vehicleId, nextDueDate])
}

/* ========================================================================== */
/* Impostos (§20)                                                             */
/* ========================================================================== */

model TaxRecord {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  kind        String   @default("iuc")
  year        Int
  amountCents Int
  date        DateTime? @db.Date
  dueDate     DateTime? @db.Date
  paid        Boolean  @default(true)
  documentId  String?
  notes       String?
  source      Json?
  reminderId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vehicleId, year])
}

/* ========================================================================== */
/* Documentos (§17)                                                           */
/* ========================================================================== */

model Document {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Um documento pode não estar associado a nenhum veículo (ex.: carta de condução).
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  name      String
  category  String
  date      DateTime? @db.Date
  expiresAt DateTime? @db.Date
  fileName  String?
  mimeType  String?
  sizeBytes Int?
  /// Referência opaca no armazenamento. Os bytes são servidos por
  /// `GET /documents/:id/content` (autenticado, restrito ao dono); o upload não existe.
  storageKey String?
  notes     String?
  source    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, category])
  @@index([vehicleId, expiresAt])
}

/* ========================================================================== */
/* Lembretes e manutenção preventiva (§16, §21, §22)                          */
/* ========================================================================== */

model Reminder {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  title    String
  /// `distance`, `time` ou `both` — o evento ocorre quando qualquer condição for
  /// atingida (§16).
  trigger  String @default("both")
  dueDate  DateTime? @db.Date
  dueOdometerKm Int?
  /// Intervalos usados para repetir automaticamente após conclusão.
  intervalMonths Int?
  intervalKm     Int?
  repeat         Boolean @default(false)
  notes          String?
  /// Categoria temática, para escolher o canal e o ícone de notificação (§22).
  topic          String @default("maintenance")
  /// Origem: `manual`, `maintenance`, `insurance`, `inspection`, `tax`, `template`.
  origin         String @default("manual")
  originRecordId String?
  /// Idempotência: impede lembretes duplicados gerados pelo mesmo fluxo.
  dedupeKey      String?
  source         Json?

  completedAt DateTime?
  /// Lembrete seguinte, quando `repeat` está ativo.
  previousReminderId String?
  snoozedUntil DateTime?
  dismissedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([vehicleId, dedupeKey])
  @@index([vehicleId, completedAt])
  @@index([userId, dueDate])
}

/* ========================================================================== */
/* Notificações (§22)                                                         */
/* ========================================================================== */

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  topic      String
  channel    String  @default("in_app")
  title      String
  body       String
  href       String?
  vehicleId  String?
  reminderId String?
  dedupeKey  String?
  readAt     DateTime?
  /// Momento em que deve ser entregue; permite agendar resumos diários/semanais.
  scheduledFor DateTime?
  sentAt     DateTime?
  createdAt  DateTime @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

/* ========================================================================== */
/* Sugestões contextuais (§7, §45)                                            */
/* ========================================================================== */

/// Estado das sugestões. As sugestões são geradas a pedido (não persistidas) e o
/// sistema guarda apenas aquilo que o utilizador decidiu sobre cada uma. Semear
/// sugestões na base de dados obrigaria a uma migração sempre que a lógica mudasse.
model SuggestionState {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Chave estável da sugestão, ex.: `vehicle.add_insurance:<vehicleId>`.
  key      String
  type     String
  vehicleId String?
  /// `done`, `dismissed`, `never`, `snoozed`.
  status   String
  snoozedUntil DateTime?
  /// Quantas vezes a sugestão já foi apresentada, para não insistir (§7).
  shownCount Int @default(0)
  lastShownAt DateTime?
  actedAt    DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId, status])
}

/* ========================================================================== */
/* Eventos (§33)                                                              */
/* ========================================================================== */

/// Modelo de eventos. Toda a ação importante é registada aqui e é desta tabela que
/// nascem a timeline (§24), as estatísticas (§23), as notificações (§22) e, no
/// futuro, as automações e as integrações (§26).
model VehicleEvent {
  id        String  @id @default(cuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      String
  /// Data civil do evento (pode diferir da data do registo que o originou).
  date      DateTime @db.Date
  title     String
  summary   String?
  icon      String?
  amountCents Int?
  odometerKm  Int?
  /// Tipo e identificador do registo de origem, para navegação reversa.
  recordType String?
  recordId   String?
  source     Json?
  /// Payload livre para consumidores externos (Home Assistant, automações).
  payload    Json?

  createdAt DateTime @default(now())

  @@index([vehicleId, date])
  @@index([userId, createdAt])
  @@index([recordType, recordId])
}

/* ========================================================================== */
/* Integrações (§26, §27, §28)                                                */
/* ========================================================================== */

model Integration {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  category String
  provider String
  label    String?
  enabled  Boolean @default(true)
  /// Configuração não sensível, devolvida ao cliente.
  config   Json?
  /// Segredos cifrados em repouso (§30). Nunca são devolvidos ao cliente.
  credentials Json?
  /// Scopes concedidos a esta integração; princípio do menor privilégio (§30).
  scopes   Json?
  lastSyncAt      DateTime?
  lastSyncStatus  String  @default("never")
  lastSyncMessage String?

  entities HomeAssistantEntity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, category, provider, vehicleId])
  @@index([userId, category])
}

/// Publicações MQTT para o Home Assistant (§27). Uma linha por entidade publicada,
/// para que o Zemlo saiba exatamente o que já anunciou e possa remover a entidade
/// quando os dados deixarem de existir.
model HomeAssistantEntity {
  id            String @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  vehicleId     String
  entityId      String
  /// `sensor`, `binary_sensor` ou `device_tracker`.
  component     String
  deviceClass   String?
  unitOfMeasurement String?
  stateTopic    String
  discoveryTopic String
  publishedState Json?
  available     Boolean @default(true)
  lastPublishedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([integrationId, entityId])
  @@index([vehicleId])
}

/* ========================================================================== */
/* Preferências do servidor                                                   */
/* ========================================================================== */

/// Chave/valor para configuração operacional que não pertence ao ambiente:
/// versão dos termos aceites, marcos de migração, interruptores de funcionalidade.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

/* ========================================================================== */
/* Importação — livro de idempotência (§9.5, decisão A26)                     */
/* ========================================================================== */

/// Livro de idempotência da importação nativa.
///
/// Cada registo criado por uma importação é registado aqui como
/// `(userId, bundleId, localId) → createdRecordId`. É o que faz
/// **reimportar o mesmo bundle não criar nada** (§9.5) e o que torna seguro
/// retomar uma importação por lotes interrompida (§7.2): a retoma consulta o
/// livro e não volta a criar o que já entrou.
///
/// Não confundir com a deduplicação por conteúdo (§8): o livro diz "já
/// importado **deste ficheiro**", a deduplicação diz "já existes **na conta**".
/// A chave inclui o `userId`, pelo que importar o mesmo bundle noutra conta
/// cria tudo — que é precisamente o que permite exportar de uma conta e
/// importar noutra.
///
/// `localId` é opaco (§2.1): nunca é interpretado, só comparado. Por isso é
/// `String` e não tem prefixo nem formato próprio guardado aqui.
model ImportBookEntry {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Identificador do bundle de origem (§5.4). Opaco, como o `localId`.
  bundleId String
  /// Identificador local do registo **dentro do bundle**. Opaco.
  localId  String
  /// Tipo do registo criado (`vehicle`, `expense`, …), para o relatório poder
  /// contar por tipo sem ir buscá-lo à tabela de destino.
  recordKind String
  /// Identificador do registo criado. `String` e não uma FK: aponta para sete
  /// tabelas diferentes, e uma FK polimórfica não existe no Prisma. O que
  /// garante a integridade é o `onDelete: Cascade` do `userId` — o livro de um
  /// utilizador desaparece com ele.
  createdRecordId String

  createdAt DateTime @default(now())
  /// Retenção de 12 meses (decisão 12 do IMPORT-EXPORT.md), configurável.
  /// Depois desta data o livro já não reconhece uma reimportação; a
  /// deduplicação por conteúdo continua a proteger.
  expiresAt DateTime

  @@unique([userId, bundleId, localId])
  @@index([userId, bundleId])
  @@index([expiresAt])
}

/* ========================================================================== */
/* Importação — mapa de colunas da Camada 2 (§10.2, §11.3)                    */
/* ========================================================================== */

/// Mapa de colunas confirmado pelo utilizador, para a Camada 2 (CSV).
///
/// A §10.2 (passo 9) e a §11.3 ("Não pedir duas vezes") pedem que o mapa fique
/// guardado **por utilizador e por forma de ficheiro**: a segunda importação do
/// mesmo fornecedor passa a ser um clique em vez de um ecrã de mapeamento.
///
/// ## Porque é que a chave é a assinatura do cabeçalho e não o nome do ficheiro
///
/// Um nome é um rótulo: `export.csv`, `export (1).csv` e `Movimentos 2026.csv`
/// são o mesmo formato. O que define a "forma" é **o conjunto de colunas** — é
/// isso que faz o mapa fazer sentido ou não. A `shapeKey` é a assinatura
/// normalizada das colunas (nomes normalizados, ordenados, ligados por `|`),
/// pelo que:
///
///  - **mudar uma linha** não muda a forma → o mapa continua a servir;
///  - **acrescentar uma coluna** muda a forma → mapa novo, e o utilizador volta a
///    confirmar (é a "mudança de formato" que a §10.2 manda detetar);
///  - **renomear o ficheiro** não muda nada.
///
/// ## Isolamento por conta
///
/// O `userId` faz parte da chave única, como no livro de idempotência. Não existe
/// nenhum mapa global: o mapa de um utilizador **nunca** é visto por outro, nem
/// como sugestão. É por isso que a leitura é sempre `findUnique` sobre a chave
/// composta, e nunca uma pesquisa por `shapeKey` sozinha.
///
/// ## O que é guardado, e o que não é
///
/// Só ficam as **decisões** (que coluna é que campo), não os valores do ficheiro.
/// Guardar amostras de valores seria guardar dados do utilizador que não são
/// precisos para reaplicar o mapa, e a §7.3 pede o mínimo. As convenções que a
/// §10.4 manda guardar (`dateOrder`, `decimalStyle`) ficam aqui porque a
/// especificação o diz explicitamente: "a resposta fica guardada no mapa".
model ColumnMap {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Assinatura normalizada das colunas. Ver o docblock do modelo.
  shapeKey String
  /// Nomes das colunas tal como estavam no ficheiro, para o relatório poder
  /// mostrar o que foi reconhecido sem reinterpretar a assinatura. É a única
  /// informação do ficheiro guardada aqui, e é sobre a **forma**, não sobre o
  /// conteúdo: um cabeçalho não é um dado pessoal.
  headers Json

  /// Tipo de registo a que este mapa se aplica (`fuel`, `expense`, …). Faz parte
  /// da chave porque o mesmo cabeçalho pode servir dois tipos com significados
  /// diferentes: numa tabela `Data;Valor;Litros`, `Litros` é litros; numa tabela
  /// `Data;Valor;Categoria`, a mesma coluna não existe — mas `Data;Valor;Tipo`
  /// mapeia para `type` num caso e para `category` no outro.
  kind String

  /// Decisões de coluna: `[{ index, field }]`. `field: null` = ignorar a coluna,
  /// que a §10.4 diz ser uma resposta legítima.
  decisions Json

  /// Separação de campos do ficheiro (`;`, `,`, `\t`). Guardada para o relatório
  /// poder reconstruir a leitura sem reanalisar, e para detetar que o ficheiro do
  /// mesmo fornecedor mudou de separador.
  delimiter String
  /// Codificação detetada (`utf-8`, `utf-8-bom`, `windows-1252`).
  encoding  String

  /// Convenção de datas confirmada (§10.4), quando o utilizador teve de decidir.
  /// `null` quando era inequívoca — nesse caso não há nada a recordar.
  dateOrder String?
  /// Convenção de separador decimal confirmada (§10.4).
  decimalStyle String?

  /// Quantas vezes este mapa foi aplicado. Serve para ordenar sugestões e para o
  /// utilizador ver que um mapa está a ser usado (o relatório di-lo).
  timesUsed Int      @default(0)
  /// Última aplicação. Distingue mapas vivos de mapas esquecidos.
  lastUsedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, kind, shapeKey])
  @@index([userId, kind])
}

/* ========================================================================== */
/* Preparação para famílias e frotas (§32) — fora do MVP (§40)                */
/* ========================================================================== */

model Household {
  id        String @id @default(cuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  HouseholdMember[]
  vehicles Vehicle[]
}

model HouseholdMember {
  id          String @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// `owner`, `admin`, `member`, `viewer`.
  role        String    @default("member")
  createdAt   DateTime  @default(now())

  @@unique([householdId, userId])
}

model Organization {
  id        String @id @default(cuid())
  name      String
  vatNumber String?
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members OrganizationMember[]
}

model OrganizationMember {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
}
