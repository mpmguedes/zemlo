# Dependências
node_modules/

# Artefactos de build
dist/
build/
*.tsbuildinfo

# Clientes Prisma gerados.
#
# Reconstruídos a partir dos schemas por `npm run db:generate`, que corre no
# `postinstall`. O schema é a fonte única de verdade; o cliente é derivado e não pertence
# ao repositório.
apps/api/prisma/generated/

# Bases de dados locais
*.db
*.db-journal
*.sqlite
*.sqlite3
apps/api/prisma/sqlite/*.db*

# Ambiente (nunca versionar segredos)
.env
.env.local
.env.*.local
!.env.example

# Ficheiros temporários e de depuração.
#
# A entrada `.tmp-*` não é cosmética: durante o desenvolvimento criou-se um ficheiro
# `.tmp-token.txt` na raiz com um token de sessão do utilizador de demonstração, gerado
# para inspecionar respostas da API. É exatamente o tipo de ficheiro que acaba num commit
# por distração — e um token no histórico do Git é um segredo comprometido, mesmo depois
# de o ficheiro ser apagado.
.tmp-*
*.tmp
*~

# Scripts de depuração pontuais (prefixo `_`, por convenção do projeto)
**/scripts/_*

# Logs
*.log
npm-debug.log*
logs/

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Editores
.vscode/*
!.vscode/extensions.json
.idea/

# Testes
coverage/
.vitest/

# Ficheiros de configuração transitórios do Vite/Vitest.
# São criados e removidos pelo próprio Vite ao carregar `vite.config.ts`; ficam para trás
# quando um processo é interrompido. Nunca devem entrar num commit.
*.timestamp-*.mjs
