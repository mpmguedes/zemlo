# =============================================================================
# Zemlo API — variáveis de ambiente
# =============================================================================
# Copiar para `.env` e preencher. O ficheiro `.env` nunca é versionado.
# Em produção (staging/produção, §37) estas variáveis vêm do gestor de segredos
# do sistema, não de um ficheiro no repositório.
# =============================================================================

# --- Ambiente ---------------------------------------------------------------
# development | test | staging | production
NODE_ENV=development
# Porta HTTP. Em produção fica atrás do Cloudflare Tunnel (§36).
PORT=4000
# Interface de escuta. `127.0.0.1` por omissão: só o túnel expõe a API.
HOST=127.0.0.1
# Prefixo público da API, usado em links de email e na documentação de integrações.
PUBLIC_BASE_URL=http://127.0.0.1:4000

# --- Base de dados ----------------------------------------------------------
# Produção: PostgreSQL (schema canónico em prisma/schema.prisma).
#   DATABASE_URL=postgresql://zemlo:password@127.0.0.1:5432/zemlo?schema=public
# Desenvolvimento local: SQLite (schema gerado em prisma/sqlite/schema.sqlite.prisma).
DATABASE_URL=file:./dev.db
# Motor ativo. `postgresql` | `sqlite`.
#
# Esta variável NÃO é apenas informativa: é ela que seleciona fisicamente qual dos dois
# clientes Prisma gerados o processo instancia. Os dois têm saídas distintas
# (prisma/generated/postgres e prisma/generated/sqlite) precisamente para que o cliente
# errado não possa ser carregado por engano — antes partilhavam um caminho e o SQLite
# acabava por substituir o de PostgreSQL em silêncio.
#
# O `/health` reporta o motor do cliente realmente carregado, não este valor. E o
# arranque é recusado se os dois não coincidirem, ou se um cliente SQLite aparecer com
# NODE_ENV=production.
DATABASE_PROVIDER=sqlite

# --- Segurança --------------------------------------------------------------
# Segredo de assinatura dos tokens de acesso. Mínimo 32 caracteres aleatórios.
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=troca-este-valor-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
# Validade do token de acesso, em minutos. Curto: o refresh token trata da longevidade.
ACCESS_TOKEN_TTL_MINUTES=60
# Validade da sessão (refresh token), em dias. Mobile-first: 90 dias.
SESSION_TTL_DAYS=90
# Chave de cifragem dos segredos em repouso (segredos TOTP, credenciais de
# integrações). 32 bytes em base64. Se estiver vazia, os segredos não são
# persistidos e as funcionalidades que deles dependem ficam desativadas.
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- CORS -------------------------------------------------------------------
# Origens permitidas, separadas por vírgula. A app web em desenvolvimento corre
# em 5173; em produção a API serve a aplicação, pelo que a lista pode ficar vazia.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Aceitar qualquer origem. Existe para desenvolvimento local (outra máquina, outra
# porta) e **nunca** deve ser `true` em produção: permitiria que qualquer site
# fizesse pedidos autenticados em nome do utilizador. Por omissão é `true` em
# desenvolvimento e `false` nos restantes ambientes.
CORS_ALLOW_ALL=false

# --- Passwords (§30) --------------------------------------------------------
# Custo do bcrypt. Cada incremento duplica o tempo de cálculo. 12 é o valor
# recomendado para um servidor modesto; 4–6 só fazem sentido em testes, onde o
# tempo de hashing domina a duração da suite.
BCRYPT_ROUNDS=12

# --- Limitação de abuso (§30) ----------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=600
# Limite das rotas de autenticação, aplicado por IP **e** por email: um atacante
# não consegue contorná-lo mudando de IP contra a mesma conta.
RATE_LIMIT_AUTH_MAX_REQUESTS=20

# --- Login federado (§29) ---------------------------------------------------
# O login Google fica ativo quando ambos os valores estiverem preenchidos. Sem
# eles, a API arranca normalmente e o cliente mostra a opção desativada com uma
# nota honesta, em vez de falhar de forma opaca.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Apple: previsto na especificação (§29) mas **não implementado**. O Sign in with
# Apple exige um identificador de app registado, e isso só existe quando houver
# uma app iOS publicada — a preparação sem esse registo não seria testável. Não
# há variáveis aqui porque não há código que as leia: uma variável de ambiente
# documentada que nada consome é pior do que nenhuma, porque sugere uma
# funcionalidade que não existe.

# --- Email (§22) ------------------------------------------------------------
# Sem configuração de email, as notificações ficam apenas dentro da aplicação.
#
# ⚠️  A recuperação de password depende desta configuração. A geração e validação do
# token funcionam sempre, mas sem SMTP o link é escrito no log em vez de entregue — o que
# serve para desenvolvimento e não serve para utilizadores reais. Ao ligar um fornecedor,
# implementa-se `EmailSender` em `apps/api/src/services/email.ts` e registra-se com
# `setEmailSender`; nada do fluxo de tokens muda.
#
# O link de recuperação é construído sobre PUBLIC_BASE_URL: se essa variável apontar para
# o endereço errado, os emails levam a um endereço que não existe.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Zemlo <ola@appzemlo.com>

# --- Integrações (§26) ------------------------------------------------------
# Nenhuma integração de fabricante é ativada por omissão: a especificação exige
# que se prefira uma API oficial e nunca engenharia reversa.
HA_MQTT_URL=
HA_MQTT_USERNAME=
HA_MQTT_PASSWORD=
HA_DISCOVERY_PREFIX=homeassistant

# --- Observabilidade (§56) --------------------------------------------------
LOG_LEVEL=info
LOG_PRETTY=true
